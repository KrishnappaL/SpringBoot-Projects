package interviewcoding;

import java.util.Collections;
import java.util.PriorityQueue;
import java.util.Queue;

public class Solution4 {
			public static void main(String[] args) {
			//int[] a = {5,71,100,170}; //5,17,35,71,100,102.103,170 (Median is (71+100) / 2 ==> 85.5
		//	int[] b = {17,35,102,103};
				addNum(20);
				addNum(13);
				addNum(50);
			System.out.println(findMedian());
		}
			private static PriorityQueue<Integer> small = new PriorityQueue<>(Collections.reverseOrder());
			private static PriorityQueue<Integer> large = new PriorityQueue<>();
			private static boolean even = true;

			public static double findMedian() {
			    if (even)
			        return (small.peek() + large.peek()) / 2.0;
			    else
			        return small.peek();
			}

			public static void addNum(int num) {
			    if (even) {
			        large.offer(num);
			        small.offer(large.poll());
			    } else {
			        small.offer(num);
			        large.offer(small.poll());
			    }
			    even = !even;
			}
	}

