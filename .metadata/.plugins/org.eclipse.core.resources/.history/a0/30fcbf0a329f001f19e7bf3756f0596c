package interviewcoding;

import java.util.ArrayList;
import java.util.List;

public class GuessStatisticsMessage {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
	}
	 public static List<Integer> getMax(List<String> operations) {
	       List<Integer> maximum=new ArrayList()<Integer>();
	       List<Integer> push=new ArrayList<Integer>();
	    for(String op:operations){
	       int stackCondition= Integer.parseInt(op.split(" ")[0]);
	       switch(stackCondition){
	           case 1: push.add(Integer.parseInt(op.split(" ")[1]));
	           break;
	           case 2: push.remove(push.size()-1);
	           break;
	           case 3:maximum.add(Collections.max(push));
	           break;
	       }
	    }
	           return maximum;
	    }

}
